{
  "name": "graph-lab",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive playground for generating, visualizing, and inspecting graphs.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
